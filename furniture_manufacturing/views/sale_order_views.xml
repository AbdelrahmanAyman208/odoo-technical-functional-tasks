<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_website_order" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.website.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_website_order" invisible="not is_website_order" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
