<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_brand" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.brand</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="product_brand_ids" column_invisible="True"/>
                <field name="brand_id" 
                       optional="show" 
                       domain="[('id', 'in', product_brand_ids)]"
                       invisible="not product_brand_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
